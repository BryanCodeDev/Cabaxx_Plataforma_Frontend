# .env.example — Frontend Cabaxx (Bogotá D.C., Colombia)
# ─────────────────────────────────────────────────────────
# Copia este archivo a `.env` (desarrollo local) o
# `.env.production` (deploy en Netlify).
# ─────────────────────────────────────────────────────────
#
# DESARROLLO LOCAL (.env):
#   VITE_API_URL=http://localhost:4000/api/v1
#   VITE_CLIENT_URL=http://localhost:5173
#   VITE_ARTIST_SLUG=cabaxx
#
# PRODUCCIÓN — Netlify (.env.production):
#   VITE_API_URL=/api/v1                              ← relativo, el proxy de netlify.toml lo reenvía a Railway
#   VITE_CLIENT_URL=https://cabaxx.netlify.app
#   VITE_ARTIST_SLUG=cabaxx
#
# Si en algún momento decides NO usar el proxy de Netlify
# y llamar directo al backend, usa la URL absoluta:
#   VITE_API_URL=https://cabaxxplataformabackend-production.up.railway.app/api/v1
# En ese caso asegúrate de que el backend tenga ese origen
# en CORS_ORIGIN y en la CSP connect-src.
# ─────────────────────────────────────────────────────────

VITE_API_URL=/api/v1
VITE_CLIENT_URL=https://cabaxx.netlify.app
VITE_ARTIST_SLUG=cabaxx
