# .env.production — Frontend Cabaxx (Netlify)
# ─────────────────────────────────────────────────────────
# En producción, VITE_API_URL es RELATIVA (/api/v1) porque
# el redirect de netlify.toml proxy-ea esa ruta al backend
# de Railway. Así el navegador ve mismo origen y no hay CORS.
#
# VITE_CLIENT_URL debe coincidir con el dominio público
# donde está desplegado el frontend en Netlify.
# ─────────────────────────────────────────────────────────

VITE_API_URL=/api/v1
VITE_CLIENT_URL=https://cabaxx.netlify.app
VITE_ARTIST_SLUG=cabaxx
